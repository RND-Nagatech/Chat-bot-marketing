PORT=3000
FRONTEND_URL=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/whatsapp-chatbot
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
AUTO_CONNECT_WHATSAPP=false
LOG_LEVEL=info
AI_RAG_ENABLED=false
LLM_CHAT_PROVIDER=deepseek
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=replace-with-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=max
EMBEDDING_PROVIDER=local_hash
LOCAL_EMBEDDING_DIMENSIONS=384
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wa_knowledge_chunks
QDRANT_API_KEY=
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
LLM_TIMEOUT_MS=30000
LLM_CHAT_MAX_TOKENS=2400
LLM_CONTINUATION_MAX_ROUNDS=2
KNOWLEDGE_MAX_FILE_MB=10
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.25
RAG_CHUNK_CHARS=1200
RAG_MEMORY_MESSAGES=8
KNOWLEDGE_OCR_ENABLED=true
KNOWLEDGE_OCR_LANG=eng
WA_IMAGE_OCR_ENABLED=true
WA_IMAGE_SAVE_TO_KNOWLEDGE=true
WA_TYPING_INDICATOR_ENABLED=true
WA_TYPING_MIN_MS=900
WA_TYPING_MAX_MS=3500
WA_TYPING_CHARS_PER_SECOND=45
WA_TYPING_KEEP_ALIVE_MS=4500
CHAT_HISTORY_RETENTION_DAYS=30
CHAT_THREAD_LIMIT=200
